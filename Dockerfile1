### STAGE 1: Build ###
FROM node:16-alpine AS build 
WORKDIR /app
COPY . . 
RUN npm install --force

ARG configuration=production
RUN npm run build -- --output-path=./dist/frontend-application  --configuration $configuration

### STAGE 2: Run ###
FROM nginx:alpine

# Copie les fichiers frontend construits dans l'image
COPY --from=build /app/dist/frontend-application /usr/share/nginx/html

# Crée et copie la configuration Nginx personnalisée
RUN echo 'server {' > /etc/nginx/conf.d/default.conf && \
    echo '    listen 80;' >> /etc/nginx/conf.d/default.conf && \
    echo '    location / {' >> /etc/nginx/conf.d/default.conf && \
    echo '        root /usr/share/nginx/html;' >> /etc/nginx/conf.d/default.conf && \
    echo '        index index.html index.htm;' >> /etc/nginx/conf.d/default.conf && \
    echo '        try_files $uri $uri/ /index.html =404;' >> /etc/nginx/conf.d/default.conf && \
    echo '    }' >> /etc/nginx/conf.d/default.conf && \
    echo '}' >> /etc/nginx/conf.d/default.conf

EXPOSE 80
ENTRYPOINT ["nginx", "-g", "daemon off;"]
